<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MovieDatabase.DetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:MovieDatabase.ViewModel"
    xmlns:model="clr-namespace:MovieDatabase.Model"
    Title="{Binding Movie.Title}"
    x:DataType="viewmodel:MovieDetailsViewModel">
	<Grid RowDefinitions="*,Auto">
		<ScrollView Grid.Row="0" BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
		<Grid RowDefinitions="*,Auto">
			<VerticalStackLayout Grid.Row="0" Padding="10" Spacing="10">

				<Label Style="{StaticResource LargeLabel}"
                   TextColor="White"
                   FontAttributes="Bold"
                   Text="{Binding Movie.Title}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,8"
                   IsVisible="{Binding IsNotEditing}"/>
				<Entry Text="{Binding Movie.Title}"
                   Placeholder="Title"
                   HorizontalTextAlignment="Start"
                   IsVisible="{Binding IsEditing}"/>

				<Label Style="{StaticResource MediumLabel}"
                   Text="{Binding Movie.Description}"
                   IsVisible="{Binding IsNotEditing}"/>
				<Editor Text="{Binding Movie.Description}"
                    Placeholder="Description"
                    AutoSize="TextChanges"
                    IsVisible="{Binding IsEditing}"/>

				<Label Style="{StaticResource SmallLabel}"
                   Text="{Binding Movie.Director, StringFormat='Director: {0}'}"
                   IsVisible="{Binding IsNotEditing}"/>
				<Entry Text="{Binding Movie.Director}"
                   Placeholder="Director"
                   IsVisible="{Binding IsEditing}"/>

				<Label Style="{StaticResource SmallLabel}"
                   Text="{Binding Movie.ActorsDisplay, StringFormat='Actors: {0}'}"
                   IsVisible="{Binding IsNotEditing}"/>
				<Entry Text="{Binding ActorsText}"
                   Placeholder="Actors (comma separated)"
                   IsVisible="{Binding IsEditing}"/>

				<Label Style="{StaticResource SmallLabel}"
                   Text="{Binding Movie.Year, StringFormat='Year: {0:yyyy}'}"
                   IsVisible="{Binding IsNotEditing}"/>
				<Entry Text="{Binding YearText}"
                   Placeholder="Year"
                   Keyboard="Numeric"
                   IsVisible="{Binding IsEditing}"/>

				<Label Style="{StaticResource SmallLabel}"
                   Text="{Binding Movie.DisplayId, StringFormat='ID: {0}'}"
                   IsVisible="{Binding IsNotEditing}"/>
				<Entry Text="{Binding Movie.DisplayId}"
                   Placeholder="Display ID"
                   IsVisible="{Binding IsEditing}"/>

				<Label Style="{StaticResource SmallLabel}"
                   Text="Tags"
                   IsVisible="{Binding IsNotEditing}"/>
				<HorizontalStackLayout
                    Spacing="6"
                    IsVisible="{Binding IsNotEditing}"
                    BindableLayout.ItemsSource="{Binding AssignedTagBadges}">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="model:TagBadge">
							<Border Style="{StaticResource TagChip}"
                                Background="{Binding ColorIndex, Converter={StaticResource ColorIndexToColorConverter}}"
                                Stroke="{Binding ColorIndex, Converter={StaticResource ColorIndexToColorConverter}}">
								<Label Text="{Binding Name}"
                                    TextColor="{Binding ColorIndex, Converter={StaticResource ColorIndexToContrastTextColorConverter}}"
                                    FontSize="11" />
							</Border>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</HorizontalStackLayout>
				<VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding TagOptions}"
                    IsVisible="{Binding IsEditing}"
                    Spacing="4">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="viewmodel:TagOption">
							<HorizontalStackLayout Spacing="6">
								<CheckBox IsChecked="{Binding IsSelected}" />
								<Border WidthRequest="16" HeightRequest="16"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource Gray300}"
                                    Background="{Binding ColorIndex, Converter={StaticResource ColorIndexToColorConverter}}"
                                    VerticalOptions="Center" />
								<Label Text="{Binding Name}" VerticalOptions="Center" />
							</HorizontalStackLayout>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</VerticalStackLayout>

			</VerticalStackLayout>

			<HorizontalStackLayout
                Grid.Row="0"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Spacing="4">
				<ImageButton
                    Style="{StaticResource IconImageButton}"
                    Source="{FontImageSource FontFamily=MaterialIconsOutlined, Glyph=&#xe87e;, Color={StaticResource Primary}, Size={StaticResource IconGlyphSize}}"
                    Command="{Binding ToggleFavoriteCommand}"
                    HorizontalOptions="End"
                    VerticalOptions="Center">
					<ImageButton.Triggers>
						<DataTrigger TargetType="ImageButton" Binding="{Binding Movie.Favorite}" Value="True">
							<Setter Property="Source" Value="{FontImageSource FontFamily=MaterialIconsOutlined, Glyph=&#xe87d;, Color={StaticResource Primary}, Size={StaticResource IconGlyphSize}}" />
						</DataTrigger>
					</ImageButton.Triggers>
				</ImageButton>
			</HorizontalStackLayout>
		</Grid>
		</ScrollView>

		<HorizontalStackLayout
            Grid.Row="1"
            HorizontalOptions="End"
            Padding="10"
            Spacing="8">
			<Button
                Text=""
                Style="{StaticResource IconButton}"
                Command="{Binding ToggleEditCommand}">
				<Button.ImageSource>
					<FontImageSource FontFamily="MaterialIconsOutlined" Glyph="&#xe145;" Size="{StaticResource IconGlyphSize}" Color="{StaticResource Primary}" />
				</Button.ImageSource>
				<Button.Triggers>
					<DataTrigger TargetType="Button" Binding="{Binding IsEditing}" Value="True">
						<Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
						<Setter Property="ImageSource">
							<Setter.Value>
								<FontImageSource FontFamily="MaterialIconsOutlined" Glyph="&#xe5ca;" Size="{StaticResource IconGlyphSize}" Color="White" />
							</Setter.Value>
						</Setter>
					</DataTrigger>
				</Button.Triggers>
			</Button>
			<Button
                Text=""
                Style="{StaticResource IconButton}"
                Command="{Binding DiscardEditCommand}"
                IsVisible="{Binding IsEditing}">
				<Button.ImageSource>
					<FontImageSource FontFamily="MaterialIconsOutlined" Glyph="&#xe5c9;" Size="{StaticResource IconGlyphSize}" Color="{StaticResource Primary}" />
				</Button.ImageSource>
			</Button>
		</HorizontalStackLayout>
	</Grid>
</ContentPage>
