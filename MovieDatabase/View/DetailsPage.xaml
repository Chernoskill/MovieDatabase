<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MovieDatabase.DetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:MovieDatabase.ViewModel"
    Title="{Binding Movie.Title}"
    x:DataType="viewmodel:MovieDetailsViewModel">
	<ScrollView BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
		<Grid RowDefinitions="Auto,Auto,*">
			<BoxView
                BackgroundColor="{StaticResource Primary}"
                Grid.RowSpan="2"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"/>

			<Border StrokeShape="RoundRectangle 80"
                    Stroke="White"
                    StrokeThickness="6"
                    HeightRequest="172"
                    WidthRequest="172"
                    Margin="0,8,0,0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
			</Border>

			<Label Style="{StaticResource LargeLabel}" 
                   Grid.Row="1"
                   TextColor="White"
                   FontAttributes="Bold"
                   Text="{Binding Movie.Title}" 
                   HorizontalOptions="Center"
                   Margin="0,0,0,8"/>

			<VerticalStackLayout Grid.Row="2" Padding="10" Spacing="10">
				<Label Style="{StaticResource MediumLabel}" Text="{Binding Movie.Description}" />
				<Label Style="{StaticResource SmallLabel}" Text="{Binding Movie.Year, StringFormat='Year: {0}'}" />
				<ImageButton
                    Source="fav0.png"
                    Command="{Binding ToggleFavoriteCommand}"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Padding="0"
                    HeightRequest="32"
                    WidthRequest="32"
                    HorizontalOptions="Start">
					<ImageButton.Triggers>
						<DataTrigger TargetType="ImageButton" Binding="{Binding Movie.Favorite}" Value="True">
							<Setter Property="Source" Value="fav1.png" />
						</DataTrigger>
					</ImageButton.Triggers>
				</ImageButton>
			</VerticalStackLayout>
		</Grid>
	</ScrollView>
</ContentPage>