<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MovieDatabase.DetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:MovieDatabase.ViewModel"
    xmlns:model="clr-namespace:MovieDatabase.Model"
    Title="{Binding Movie.Title}"
    x:DataType="viewmodel:MovieDetailsViewModel">
	<ScrollView BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
		<Grid RowDefinitions="*,Auto">
			<VerticalStackLayout Grid.Row="0" Padding="10" Spacing="10">

				<Label Style="{StaticResource LargeLabel}"
                   TextColor="White"
                   FontAttributes="Bold"
                   Text="{Binding Movie.Title}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,8"
                   IsVisible="{Binding IsNotEditing}"/>
				<Entry Text="{Binding Movie.Title}"
                   Placeholder="Title"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding IsEditing}"/>

				<Label Style="{StaticResource MediumLabel}"
                   Text="{Binding Movie.Description}"
                   IsVisible="{Binding IsNotEditing}"/>
				<Editor Text="{Binding Movie.Description}"
                    Placeholder="Description"
                    AutoSize="TextChanges"
                    IsVisible="{Binding IsEditing}"/>

				<Label Style="{StaticResource SmallLabel}"
                   Text="{Binding Movie.Director, StringFormat='Director: {0}'}"
                   IsVisible="{Binding IsNotEditing}"/>
				<Entry Text="{Binding Movie.Director}"
                   Placeholder="Director"
                   IsVisible="{Binding IsEditing}"/>

				<Label Style="{StaticResource SmallLabel}"
                   Text="{Binding Movie.ActorsDisplay, StringFormat='Actors: {0}'}"
                   IsVisible="{Binding IsNotEditing}"/>
				<Entry Text="{Binding ActorsText}"
                   Placeholder="Actors (comma separated)"
                   IsVisible="{Binding IsEditing}"/>

				<Label Style="{StaticResource SmallLabel}"
                   Text="{Binding Movie.Year, StringFormat='Year: {0:yyyy}'}"
                   IsVisible="{Binding IsNotEditing}"/>
				<Entry Text="{Binding YearText}"
                   Placeholder="Year"
                   Keyboard="Numeric"
                   IsVisible="{Binding IsEditing}"/>

				<Label Style="{StaticResource SmallLabel}"
                   Text="Tags"
                   IsVisible="{Binding IsNotEditing}"/>
				<HorizontalStackLayout
                    Spacing="6"
                    IsVisible="{Binding IsNotEditing}"
                    BindableLayout.ItemsSource="{Binding AssignedTagBadges}">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="model:TagBadge">
							<Border Style="{StaticResource TagChip}"
                                Background="{Binding ColorIndex, Converter={StaticResource ColorIndexToColorConverter}}"
                                Stroke="{Binding ColorIndex, Converter={StaticResource ColorIndexToColorConverter}}">
								<Label Text="{Binding Name}"
                                    TextColor="{Binding ColorIndex, Converter={StaticResource ColorIndexToContrastTextColorConverter}}"
                                    FontSize="11" />
							</Border>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</HorizontalStackLayout>
				<VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding TagOptions}"
                    IsVisible="{Binding IsEditing}"
                    Spacing="4">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="viewmodel:TagOption">
							<HorizontalStackLayout Spacing="6">
								<CheckBox IsChecked="{Binding IsSelected}" />
								<Border WidthRequest="16" HeightRequest="16"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource Gray300}"
                                    Background="{Binding ColorIndex, Converter={StaticResource ColorIndexToColorConverter}}"
                                    VerticalOptions="Center" />
								<Label Text="{Binding Name}" VerticalOptions="Center" />
							</HorizontalStackLayout>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</VerticalStackLayout>

			</VerticalStackLayout>

			<HorizontalStackLayout
                Grid.Row="0"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Spacing="4">
				<Button
                    Text="e"
                    Style="{StaticResource ButtonOutline}"
                    Command="{Binding ToggleEditCommand}"
                    WidthRequest="40"
                    HeightRequest="40"
                    Padding="0">
					<Button.Triggers>
						<DataTrigger TargetType="Button" Binding="{Binding IsEditing}" Value="True">
							<Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
							<Setter Property="TextColor" Value="White" />
						</DataTrigger>
					</Button.Triggers>
				</Button>
				<ImageButton
                    Source="fav0.png"
                    Command="{Binding ToggleFavoriteCommand}"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Padding="0"
                    HeightRequest="32"
                    WidthRequest="32"
                    HorizontalOptions="End"
                    VerticalOptions="Center">
					<ImageButton.Triggers>
						<DataTrigger TargetType="ImageButton" Binding="{Binding Movie.Favorite}" Value="True">
							<Setter Property="Source" Value="fav1.png" />
						</DataTrigger>
					</ImageButton.Triggers>
				</ImageButton>
			</HorizontalStackLayout>
		</Grid>
	</ScrollView>
</ContentPage>
