<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MovieDatabase.FilterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:MovieDatabase.ViewModel"
    xmlns:loc="clr-namespace:MovieDatabase.Localization"
    Title="{loc:Translate FilterPage_Title}"
    x:DataType="viewmodel:FilterViewModel">
	<ScrollView BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
		<VerticalStackLayout Padding="10" Spacing="10">

			<Label Style="{StaticResource MediumLabel}" Text="{loc:Translate FilterPage_TitleLabel}" />
			<Entry Text="{Binding TitleFilter}" Placeholder="{loc:Translate FilterPage_TitlePlaceholder}" />

			<Label Style="{StaticResource MediumLabel}" Text="{loc:Translate FilterPage_DescriptionLabel}" />
			<Entry Text="{Binding DescriptionFilter}" Placeholder="{loc:Translate FilterPage_DescriptionPlaceholder}" />

			<Label Style="{StaticResource MediumLabel}" Text="{loc:Translate FilterPage_DirectorLabel}" />
			<Entry Text="{Binding DirectorFilter}" Placeholder="{loc:Translate FilterPage_DirectorPlaceholder}" />

			<Label Style="{StaticResource MediumLabel}" Text="{loc:Translate FilterPage_ActorsLabel}" />
			<Entry Text="{Binding ActorsFilter}" Placeholder="{loc:Translate FilterPage_ActorsPlaceholder}" />

			<Label Style="{StaticResource MediumLabel}" Text="{loc:Translate FilterPage_YearRangeLabel}" />
			<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
				<Entry Grid.Column="0" Text="{Binding YearFromText}" Placeholder="{loc:Translate FilterPage_YearFromPlaceholder}" Keyboard="Numeric" />
				<Entry Grid.Column="1" Text="{Binding YearToText}" Placeholder="{loc:Translate FilterPage_YearToPlaceholder}" Keyboard="Numeric" />
			</Grid>

			<Label Style="{StaticResource MediumLabel}" Text="{loc:Translate FilterPage_FavoriteLabel}" />
			<Picker ItemsSource="{Binding FavoriteOptions}" SelectedItem="{Binding FavoriteOption}" />

			<Label Style="{StaticResource MediumLabel}" Text="{loc:Translate FilterPage_TagsLabel}" />
			<VerticalStackLayout BindableLayout.ItemsSource="{Binding TagOptions}" Spacing="4">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="viewmodel:TagOption">
						<HorizontalStackLayout Spacing="6">
							<CheckBox IsChecked="{Binding IsSelected}" />
							<Border WidthRequest="16" HeightRequest="16"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="1"
                                Stroke="{StaticResource Gray300}"
                                Background="{Binding ColorIndex, Converter={StaticResource ColorIndexToColorConverter}}"
                                VerticalOptions="Center" />
							<Label Text="{Binding Name}" VerticalOptions="Center" />
						</HorizontalStackLayout>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</VerticalStackLayout>

			<HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,10,0,0">
				<Button Text="{loc:Translate FilterPage_ClearAll}" Style="{StaticResource ButtonOutline}" Command="{Binding ClearAllCommand}" FontSize="18"/>
				<Button Text="{loc:Translate Common_Cancel}" Style="{StaticResource ButtonOutline}" Command="{Binding CancelCommand}" FontSize="18"/>
				<Button Text="{loc:Translate FilterPage_Apply}" Command="{Binding ApplyCommand}" FontSize="18"/>
			</HorizontalStackLayout>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
