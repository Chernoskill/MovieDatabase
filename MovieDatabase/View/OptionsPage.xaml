<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MovieDatabase.View.OptionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:MovieDatabase.ViewModel"
    xmlns:controls="clr-namespace:MovieDatabase.Controls"
    Title="Options"
    x:DataType="viewmodel:OptionsViewModel">
	<ScrollView BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
		<VerticalStackLayout Padding="10" Spacing="14">

			<Label Style="{StaticResource MediumLabel}" FontAttributes="Bold" Text="Tags" />

			<VerticalStackLayout BindableLayout.ItemsSource="{Binding Tags}" Spacing="8">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="viewmodel:TagListItem">
						<Border Style="{StaticResource CardView}" Padding="10">
							<VerticalStackLayout Spacing="10">

								<Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" IsVisible="{Binding IsNotEditing}">
									<Border Grid.Column="0"
                                        WidthRequest="24" HeightRequest="24"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="1"
                                        Stroke="{StaticResource Gray300}"
                                        Background="{Binding ColorIndex, Converter={StaticResource ColorIndexToColorConverter}}" />
									<Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" Style="{StaticResource MediumLabel}" />
									<Button Grid.Column="2" Text=""
                                        ImageSource="{FontImageSource FontFamily=MaterialIconsOutlined, Glyph=&#xe3c9;, Color={StaticResource Primary}, Size={StaticResource IconGlyphSize}}"
                                        Style="{StaticResource IconButton}" Command="{Binding EditCommand}" />
									<Button Grid.Column="3" Text=""
                                        ImageSource="{FontImageSource FontFamily=MaterialIconsOutlined, Glyph=&#xe872;, Color={StaticResource DangerRed}, Size={StaticResource IconGlyphSize}}"
                                        Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}" />
								</Grid>

								<VerticalStackLayout Spacing="10" IsVisible="{Binding IsEditing}">
									<Entry Text="{Binding EditName}" Placeholder="Tag name" />
									<controls:ColorPickerView SelectedIndex="{Binding EditColorIndex}" />
									<HorizontalStackLayout Spacing="10">
										<Button Text="Save" Command="{Binding SaveCommand}" />
										<Button Text="Cancel" Style="{StaticResource ButtonOutline}" Command="{Binding CancelCommand}" />
									</HorizontalStackLayout>
								</VerticalStackLayout>

							</VerticalStackLayout>
						</Border>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</VerticalStackLayout>

			<BoxView Style="{StaticResource SectionDivider}" />

			<Label Style="{StaticResource MediumLabel}" FontAttributes="Bold" Text="Add tag" />
			<Entry Text="{Binding NewTagName}" Placeholder="Tag name" />
			<controls:ColorPickerView SelectedIndex="{Binding NewTagColorIndex}" />
			<Button Text="" HorizontalOptions="Start" Command="{Binding AddTagCommand}"
                Style="{StaticResource IconButton}">
				<Button.ImageSource>
					<FontImageSource FontFamily="MaterialIconsOutlined" Glyph="&#xe145;" Size="{StaticResource IconGlyphSize}" Color="{StaticResource Primary}" />
				</Button.ImageSource>
			</Button>

			<BoxView Style="{StaticResource SectionDivider}" />

			<Label Style="{StaticResource MediumLabel}" FontAttributes="Bold" Text="Import / Export" />
			<Label Text="Import a previously exported movie database file. This replaces the current data." />
			<Button Text="Import" Command="{Binding ImportDataCommand}" HorizontalOptions="Fill" />
			<Label Text="Export the movie collection to a folder of your choice." />
			<Button Text="Export" Command="{Binding ExportDataCommand}" HorizontalOptions="Fill" />

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
