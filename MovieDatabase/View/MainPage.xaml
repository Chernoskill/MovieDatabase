<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MovieDatabase.View.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:model="clr-namespace:MovieDatabase.Model"
    xmlns:viewmodel="clr-namespace:MovieDatabase.ViewModel"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="Root"
    Title="Movies"
    x:DataType="viewmodel:MoviesViewModel">
	<Grid
        RowDefinitions="Auto,Auto,*,Auto"
        ColumnDefinitions="*,*"
        ColumnSpacing="5"
        BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
		<HorizontalStackLayout
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Padding="10,10,10,0"
            HorizontalOptions="End">
			<Button
                Text="Filter"
                Style="{StaticResource ButtonOutline}"
                Command="{Binding GoToFilterCommand}" />
		</HorizontalStackLayout>

		<ScrollView
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Orientation="Horizontal"
            IsVisible="{Binding HasActiveFilters}"
            Padding="10,10,10,0">
			<HorizontalStackLayout Spacing="6">
				<HorizontalStackLayout BindableLayout.ItemsSource="{Binding ActiveFilters}" Spacing="6">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="viewmodel:ActiveFilterChip">
							<Border StrokeShape="RoundRectangle 12" Padding="8,4" Background="{StaticResource Primary}">
								<HorizontalStackLayout Spacing="6">
									<Label Text="{Binding Label}" TextColor="White" FontSize="12" VerticalOptions="Center" />
									<Label Text="✕" TextColor="White" FontSize="12" VerticalOptions="Center">
										<Label.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding ClearCommand}" />
										</Label.GestureRecognizers>
									</Label>
								</HorizontalStackLayout>
							</Border>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</HorizontalStackLayout>
				<Button
                    Text="Clear all"
                    Style="{StaticResource ButtonOutline}"
                    Command="{Binding ClearAllFiltersCommand}" />
			</HorizontalStackLayout>
		</ScrollView>

		<RefreshView
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Command="{Binding GetMoviesCommand}"
            IsRefreshing="{Binding IsRefreshing}">
			<CollectionView
                        ItemsSource="{Binding Movies}"
                        SelectionMode="None">
				<CollectionView.EmptyView>
					<StackLayout Padding="100">
						<Image
                                    HorizontalOptions="Center"
                                    HeightRequest="160"
                                    WidthRequest="160"
                                    Source="nodata.png"
                                    VerticalOptions="Center" />
					</StackLayout>
				</CollectionView.EmptyView>
				<!--<CollectionView.ItemsLayout>
                            <GridItemsLayout  Orientation="Horizontal" Span="3"/>
                        </CollectionView.ItemsLayout>-->
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="model:Movie">
						<Grid Padding="10" HorizontalOptions="Fill">
							<Border x:Name="ItemBorder" HeightRequest="125" Style="{StaticResource CardView}">
								<Border.Triggers>
									<DataTrigger TargetType="Border" Binding="{Binding IsMarked}" Value="True">
										<Setter Property="Background" Value="LightGray" />
									</DataTrigger>
								</Border.Triggers>
								<Grid Padding="0" ColumnDefinitions="*,Auto">
									<VerticalStackLayout
                                            x:Name="TitleArea"
                                            VerticalOptions="Fill"
                                            Grid.Column="0"
                                            Padding="10">
										<VerticalStackLayout.Behaviors>
											<toolkit:TouchBehavior
                                                BindingContext="{Binding Source={x:Reference TitleArea}, Path=BindingContext}"
                                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.GoToDetailsCommand}"
                                                CommandParameter="{Binding .}"
                                                LongPressCommand="{Binding Source={x:Reference Root}, Path=BindingContext.ToggleMarkCommand}"
                                                LongPressCommandParameter="{Binding .}"
                                                LongPressDuration="400" />
										</VerticalStackLayout.Behaviors>
										<Label Style="{StaticResource LargeLabel}" Text="{Binding Title}" />
										<Label Style="{StaticResource MediumLabel}" Text="{Binding Director}" />
										<Label Style="{StaticResource SmallLabel}" Text="{Binding ActorsDisplay}" />
										<Label Style="{StaticResource MicroLabel}" Text="{Binding DisplayId, StringFormat='ID: {0}'}" Margin="0,4,0,0" />
										<HorizontalStackLayout Spacing="6" Margin="0,4,0,0" BindableLayout.ItemsSource="{Binding TagBadges}">
											<BindableLayout.ItemTemplate>
												<DataTemplate x:DataType="model:TagBadge">
													<Border Style="{StaticResource TagChip}"
                                                        Background="{Binding ColorIndex, Converter={StaticResource ColorIndexToColorConverter}}"
                                                        Stroke="{Binding ColorIndex, Converter={StaticResource ColorIndexToColorConverter}}">
														<Label Text="{Binding Name}"
                                                            TextColor="{Binding ColorIndex, Converter={StaticResource ColorIndexToContrastTextColorConverter}}"
                                                            FontSize="11" />
													</Border>
												</DataTemplate>
											</BindableLayout.ItemTemplate>
										</HorizontalStackLayout>
									</VerticalStackLayout>
									<ImageButton
                                            Grid.Column="1"
                                            Source="fav0.png"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:MoviesViewModel}}, x:DataType=viewmodel:MoviesViewModel, Path=ToggleFavoriteCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            Padding="10"
                                            HeightRequest="64"
                                            WidthRequest="64"
                                            HorizontalOptions="End"
										    VerticalOptions="Start">
										<ImageButton.Triggers>
											<DataTrigger TargetType="ImageButton" Binding="{Binding Favorite}" Value="True">
												<Setter Property="Source" Value="fav1.png" />
											</DataTrigger>
										</ImageButton.Triggers>
									</ImageButton>
								</Grid>
							</Border>
						</Grid>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</RefreshView>

		<ActivityIndicator
            Grid.Row="2"
            Grid.ColumnSpan="2"
            HorizontalOptions="Fill"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{StaticResource Primary}"
            VerticalOptions="Center" />

		<HorizontalStackLayout
            Grid.Row="3"
            Grid.ColumnSpan="2"
            Padding="10"
            Spacing="10"
            HorizontalOptions="End">
			<Button
                Text="Unmark"
                Style="{StaticResource ButtonOutline}"
                Command="{Binding UnmarkAllCommand}"
                IsVisible="{Binding HasMarkedMovies}" />
			<Button
                Text="Delete"
                Style="{StaticResource ButtonOutline}"
                Command="{Binding DeleteMarkedCommand}"
                IsVisible="{Binding HasMarkedMovies}" />
		</HorizontalStackLayout>
	</Grid>
</ContentPage>