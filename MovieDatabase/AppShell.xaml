<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Class="MovieDatabase.AppShell"
    xmlns:view="clr-namespace:MovieDatabase.View"
    xmlns:local="clr-namespace:MovieDatabase"
    Title="MovieDatabase">

	<TabBar>
		<ShellContent
            Title=""
            Icon="{FontImageSource FontFamily=MaterialIconsOutlined, Glyph=&#xe0ee;}"
            ContentTemplate="{DataTemplate view:MainPage}"
            Route="MainPage" />

		<ShellContent
            Title=""
            Icon="{FontImageSource FontFamily=MaterialIconsOutlined, Glyph=&#xe145;}"
            ContentTemplate="{DataTemplate local:DetailsPage}"
            Route="AddMovie" />

		<ShellContent
            Title=""
            Icon="{FontImageSource FontFamily=MaterialIconsOutlined, Glyph=&#xe8b8;}"
            ContentTemplate="{DataTemplate view:OptionsPage}"
            Route="OptionsPage" />
	</TabBar>

</Shell>
