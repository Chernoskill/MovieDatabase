<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MovieDatabase"
             xmlns:converters="clr-namespace:MovieDatabase.Converters"
             x:Class="MovieDatabase.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

			<converters:ColorIndexToColorConverter x:Key="ColorIndexToColorConverter" />
			<converters:ColorIndexToContrastTextColorConverter x:Key="ColorIndexToContrastTextColorConverter" />

		</ResourceDictionary>
    </Application.Resources>
</Application>
